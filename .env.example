# 复制本文件为 .env 并填写真实值：cp .env.example .env
# ===== 数据库 =====
DB_NAME=os_qa
DB_PASSWORD=change-me
# 宿主机映射的 MySQL 端口：本机已占 3306 时用 3307，服务器可改 3306
MYSQL_PORT=3307

# ===== 后端 JWT 密钥（务必改成随机长字符串）=====
JWT_SECRET=change-me-to-a-long-random-secret

# ===== 大模型 API（OpenAI 兼容协议，默认 DeepSeek，可换任意兼容服务）=====
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_NAME=

# ===== 短信（阿里云，验证码找回密码；四项留空则走开发模式，验证码打印到后端日志）=====
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
