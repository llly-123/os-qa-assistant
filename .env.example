# 复制本文件为 .env 并填写真实值：cp .env.example .env
# ===== 数据库 =====
DB_NAME=os_qa
DB_PASSWORD=change-me
# 宿主机映射的 MySQL 端口：本机已占 3306 时用 3307，服务器可改 3306
MYSQL_PORT=3307

# ===== 后端 JWT 密钥（务必改成随机长字符串）=====
JWT_SECRET=change-me-to-a-long-random-secret

# ===== 大模型 API（DeepSeek，OpenAI 兼容）=====
LANGCHAIN4J_DEEPSEEK_API_KEY=sk-your-deepseek-api-key
