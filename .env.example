# 复制本文件为 .env 并填写真实值：cp .env.example .env
# ===== 数据库 =====
DB_NAME=os_qa
DB_PASSWORD=change-me
# 宿主机映射的 MySQL 端口：本机已占 3306 时用 3307，服务器可改 3306
MYSQL_PORT=3307

# ===== 后端 JWT 密钥（务必改成随机长字符串）=====
JWT_SECRET=change-me-to-a-long-random-secret

# ===== 数据库敏感字段加密密钥（务必改成随机长字符串，生产必填）=====
# 用于加密 AI API Key、短信 AccessKey Secret 等敏感字段。
# 一旦设置后请勿随意更改，否则已加密的旧数据无法解密。
APP_ENCRYPT_KEY=change-me-to-a-long-random-encrypt-key

# 大模型 API 与短信配置请在「系统设置」页面（超级管理员登录后）填写，
# 不再通过环境变量注入，此处无需配置。
